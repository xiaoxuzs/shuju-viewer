DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5432/Universal_Viewer
DATA_ROOT=../shuju
# Production server example:
# VIEWER_ENV=production
# IMPORT_PATH_MUST_BE_UNDER_DATA_ROOT=true
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
SPECTRUM_CACHE_SIZE=256
# Offline by default: BU protein coverage uses DB base_sequence or a unique FASTA under the dataset root.
# If the dataset has no FASTA, BU_DEFAULT_FASTA_PATH can point to a shared fallback such as ../human.fasta.
BU_DEFAULT_FASTA_PATH=
# Set true only when lazy UniProt REST fetches are allowed.
BU_UNIPROT_ENABLED=false
# Native folder picker for POST /imports/pick-folder (same desktop as the API). Set false in Docker/headless.
IMPORT_NATIVE_FOLDER_PICKER=true
IMPORT_PICKER_LOOPBACK_ONLY=true
# Managed local browser uploads. Upload storage is always derived from DATA_ROOT.
IMPORT_UPLOAD_ENABLED=true
IMPORT_UPLOAD_DIR_NAME=.viewer-uploads
IMPORT_UPLOAD_DISK_RESERVE_BYTES=5368709120
IMPORT_UPLOAD_MAX_FILE_BYTES=0
IMPORT_UPLOAD_MAX_TOTAL_BYTES=0
IMPORT_UPLOAD_MAX_FILES=5000
IMPORT_UPLOAD_CHUNK_BYTES=8388608
# PFMB v2 (Hela-style full RT expansion): comma-separated reference sidecar roots.
# PFMB_V2_REFERENCE_ROOTS=../Hela_DIA_v2_PFMB_delivery_20260629
# Optional full_rt-capable bridge when available (otherwise references are used).
# PFMB_V2_BRIDGE_EXE=

# Thermo RAW -> mzML import conversion.
# Option A (recommended local tool folder): place ThermoRawFileParser.exe under
# <repo_root>/ThermoRawFileParser1.4.5/. No THERMO_RAW_FILE_PARSER_EXE value is needed.
# Option B (custom path override):
# THERMO_RAW_FILE_PARSER_EXE=D:\tools\ThermoRawFileParser\ThermoRawFileParser.exe
# RAW_CONVERSION_TIMEOUT_SECONDS=3600
# Relative paths are resolved under the selected ingest root; keep output discoverable by mzML mapping.
# RAW_CONVERSION_OUTPUT_DIR=.viewer-derived/raw-converted-mzml
# RAW_CONVERSION_FORCE=false

# ZP binary layer integration. The web process only enqueues jobs; real conversion
# runs in an isolated worker using Viewer's bundled engine by default.
# ZP_WORKER_PYTHON=
# ZP_ENGINE_PATH=vendor/zp_engine
# Optional extra PYTHONPATH entries for server-specific tools.
# ZP_WORKER_PYTHONPATH=
# ZP_BINARY_LAYER_COMMIT=<approved-binary-layer-commit-or-release>
# ZP is the default import/runtime path. Keep these true for normal use; set false only for emergency fallback.
ZP_MANAGEMENT_ENABLED=true
ZP_IMPORT_CONVERSION_ENABLED=true
# Relative roots are resolved under DATA_ROOT / ZP_OUTPUT_ROOT respectively.
# ZP_OUTPUT_ROOT=.viewer-zp
# ZP_TEMP_ROOT=.tmp
# DATA_ROOT is always allowed; add extra trusted server roots only when required.
# ZP_ALLOWED_SOURCE_ROOTS=
# ZP_DEFAULT_FORMAT_VERSION=3
# ZP_CONVERSION_TIMEOUT_SECONDS=7200
# ZP_CONVERSION_WORKER_THREADS=6
# ZP_CONVERSION_MAX_CONCURRENT_JOBS=1
# ZP_V3_ARRAY_COMPRESSION=zstd
